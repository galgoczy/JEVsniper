# Másold .env néven, töltsd ki. A .env SOHA nem kerül gitbe.
# Jev (TypeSafe) API kulcs – https://typesafe.ai
TYPESAFE_API_KEY=
# RPC URL-ek. Több is megadható vesszővel: a bot sorrendben próbálja őket, ha az egyik elutasít
# (rate limit), a következőre vált. Publikus, kulcs nélküli végpontok is jók; a `npm run verify:step2`
# mindegyiket külön leellenőrzi (chain id + válaszidő).
BASE_RPC_URL=https://mainnet.base.org,https://base-rpc.publicnode.com,https://base.llamarpc.com,https://1rpc.io/base,https://base.drpc.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com,https://rpc.nodeflare.app/robinhood/public
# Privát MEV-védett küldő RPC (opcionális; ha üres, a fenti RPC-re megy a tx)
BASE_PRIVATE_TX_RPC_URL=
ROBINHOOD_PRIVATE_TX_RPC_URL=
# A dedikált hot wallet privát kulcsa (0x...). A bot nem indul nélküle.
WALLET_PRIVATE_KEY=
# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Adat-API kulcsok (később, 11. lépés)
# DEXSCREENER_API_KEY=
